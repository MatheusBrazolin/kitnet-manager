DATABASE_URL="postgresql://usuario:senha@localhost:5432/kitmanager"
JWT_SECRET="troque-por-um-segredo-forte"
JWT_EXPIRES_IN="7d"
# development | production | test (padrão: development)
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# debug | info | warn | error (padrão: info)
LOG_LEVEL=info
# Opcional: DSN do Sentry (sentry.io) para monitoramento de erros em produção.
# Sem essa variável, o Sentry fica completamente desativado (no-op).
SENTRY_DSN=

# Recuperação de senha ("esqueci minha senha"). Sem RESEND_API_KEY o envio fica
# desativado: o fluxo continua funcionando e o link vai para o log do servidor,
# o que serve para desenvolvimento, mas em produção é preciso configurar.
# Crie a chave em https://resend.com -> API Keys.
RESEND_API_KEY=
# Remetente. Até verificar um domínio próprio na Resend, use onboarding@resend.dev
# (que só entrega para o e-mail dono da conta Resend).
EMAIL_REMETENTE="KitManager <onboarding@resend.dev>"
# URL pública do app, usada para montar o link do e-mail. Na Vercel, se não definida,
# cai no VERCEL_URL do próprio deploy.
APP_URL=http://localhost:5173

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plano {
  FREE
  PRO
}

enum PapelMembro {
  GERENTE
  VISUALIZADOR
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  plano     Plano    @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kitnets Kitnet[]
  imoveis Imovel[]

  // Pessoas com acesso à minha conta (eu sou o "dono" dos dados).
  membros Membro[] @relation("MembrosDaConta")
  // Minha própria filiação, caso eu seja membro da conta de outra pessoa.
  filiacao Membro? @relation("FiliacaoDoUsuario")
}

model Membro {
  id        Int         @id @default(autoincrement())
  papel     PapelMembro @default(GERENTE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  donoId Int
  dono   User @relation("MembrosDaConta", fields: [donoId], references: [id], onDelete: Cascade)

  userId Int  @unique
  user   User @relation("FiliacaoDoUsuario", fields: [userId], references: [id], onDelete: Cascade)
}

model Imovel {
  id        Int      @id @default(autoincrement())
  nome      String
  endereco  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  kitnets Kitnet[]
}

model Kitnet {
  id        Int      @id @default(autoincrement())
  numero    String
  valor     Float
  status    String   @default("vaga")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  imovelId Int
  imovel   Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  moradores Morador[]
  gastos    Gasto[]

  @@unique([imovelId, numero])
}

model Morador {
  id            Int      @id @default(autoincrement())
  nome          String
  telefone      String
  dataEntrada   DateTime @default(now())
  diaVencimento Int      @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  kitnetId Int
  kitnet   Kitnet @relation(fields: [kitnetId], references: [id], onDelete: Cascade)

  pagamentos Pagamento[]
}

model Pagamento {
  id             Int             @id @default(autoincrement())
  valor          Float
  // Mês de competência do aluguel (sempre truncado no dia 1, UTC) — um registro por mês.
  mesReferencia  DateTime
  vencimento     DateTime
  status         StatusPagamento @default(PENDENTE)
  // Data em que o valor foi efetivamente recebido; preenchida só quando status = PAGO.
  dataPagamento  DateTime?
  formaPagamento String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  moradorId Int
  morador   Morador @relation(fields: [moradorId], references: [id], onDelete: Cascade)

  @@unique([moradorId, mesReferencia])
  @@index([moradorId])
}

model Gasto {
  id        Int      @id @default(autoincrement())
  descricao String
  valor     Float
  data      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kitnetId Int
  kitnet   Kitnet @relation(fields: [kitnetId], references: [id], onDelete: Cascade)
}

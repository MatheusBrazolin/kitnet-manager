generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plano {
  FREE
  PRO
}

enum PapelMembro {
  GERENTE
  VISUALIZADOR
}

// Um convite só passa a valer quando a pessoa aceita. Enquanto está PENDENTE, a filiação
// existe mas ContaService.resolve a ignora — o convidado segue operando na própria conta.
enum StatusMembro {
  PENDENTE
  ACEITO
}

// Como a taxa da imobiliária é cobrada sobre o aluguel: um percentual do valor bruto
// (ex.: 10% de R$ 1.500 = R$ 150) ou um valor fixo em reais, independente do aluguel.
enum TaxaTipo {
  PERCENTUAL
  FIXA
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
  // Parcela que não vamos receber (ou já não é mais cobrada) — ex.: 1º mês repassado à
  // imobiliária, morador saiu antes do fim do contrato. Diferente de PAGO: não entra como
  // receita nem em "total em atraso"/"próximos vencimentos" (essas consultas já filtram por
  // status específico, então um pagamento ANULADO fica de fora de todas elas sem precisar
  // de nenhum filtro extra).
  ANULADO
}

enum TipoPagamento {
  // Parcela do aluguel do mês — gerada automaticamente ou lançada manualmente.
  ALUGUEL
  // Lançamento extra fora do aluguel do mês (ex.: multa, taxa, valor recebido de terceiro).
  COMPLEMENTAR
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  plano     Plano    @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kitnets      Kitnet[]
  imoveis      Imovel[]
  imobiliarias Imobiliaria[]

  // Pessoas com acesso à minha conta (eu sou o "dono" dos dados).
  membros  Membro[] @relation("MembrosDaConta")
  // Minha própria filiação, caso eu seja membro da conta de outra pessoa.
  filiacao Membro?  @relation("FiliacaoDoUsuario")
}

model Membro {
  id        Int          @id @default(autoincrement())
  papel     PapelMembro  @default(GERENTE)
  status    StatusMembro @default(PENDENTE)
  aceitoEm  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  donoId Int
  dono   User @relation("MembrosDaConta", fields: [donoId], references: [id], onDelete: Cascade)

  userId Int  @unique
  user   User @relation("FiliacaoDoUsuario", fields: [userId], references: [id], onDelete: Cascade)
}

// Administradora que intermedeia o aluguel das unidades. O sistema não movimenta
// dinheiro: a imobiliária recebe do inquilino e repassa ao proprietário já descontada a
// taxa — aqui só registramos quanto foi retido para que o controle feche.
model Imobiliaria {
  id              Int      @id @default(autoincrement())
  nome            String
  telefone        String
  // Nome do corretor ou responsável pelo contato, quando houver.
  contato         String?
  // Taxa aplicada às unidades desta imobiliária que não definirem uma taxa própria.
  taxaPadraoTipo  TaxaTipo @default(PERCENTUAL)
  taxaPadraoValor Float    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  kitnets Kitnet[]

  @@index([userId])
}

model Imovel {
  id        Int      @id @default(autoincrement())
  nome      String
  endereco  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  kitnets Kitnet[]

  @@index([userId])
}

model Kitnet {
  id              Int      @id @default(autoincrement())
  numero          String
  valor           Float
  // Taxa desta unidade especificamente. Quando nula, vale a taxa padrão da imobiliária
  // vinculada; sem imobiliária, não há taxa (gestão direta). `taxaTipo` diz se o número
  // em `taxaImobiliaria` é um percentual do aluguel ou um valor fixo em reais — antes
  // da coluna existir, todo valor gravado era fixo, daí o default FIXA na migration.
  taxaImobiliaria Float?
  taxaTipo        TaxaTipo @default(FIXA)
  status          String   @default("vaga")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  imovelId Int
  imovel   Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  // Nula = gestão direta (proprietário aluga sem intermediação).
  // SetNull e não Cascade: apagar a administradora jamais pode apagar as unidades. Na
  // prática o service bloqueia a exclusão enquanto houver unidades vinculadas, igual ao
  // que ImoveisService faz com imóveis que ainda têm unidades.
  imobiliariaId Int?
  imobiliaria   Imobiliaria? @relation(fields: [imobiliariaId], references: [id], onDelete: SetNull)

  moradores      Morador[]
  gastos         Gasto[]
  historicoValor KitnetValorHistorico[]

  @@unique([imovelId, numero])
  @@index([userId])
  // O dashboard agrupa unidades, bruto, taxa e líquido por administradora.
  @@index([imobiliariaId])
}

// Registro append-only de cada valor de aluguel que a unidade já teve — criado uma vez na
// criação da kitnet, e de novo toda vez que `Kitnet.valor` muda. Sem isso, reajustar o
// aluguel de um morador sobrescreve o valor antigo sem deixar rastro de quando/para quanto
// mudou.
model KitnetValorHistorico {
  id           Int      @id @default(autoincrement())
  valor        Float
  vigenteDesde DateTime @default(now())
  createdAt    DateTime @default(now())

  kitnetId Int
  kitnet   Kitnet @relation(fields: [kitnetId], references: [id], onDelete: Cascade)

  @@index([kitnetId])
}

model Morador {
  id            Int       @id @default(autoincrement())
  nome          String
  telefone      String
  dataEntrada   DateTime  @default(now())
  // Quando preenchida, a locação está encerrada: nenhuma parcela nova é gerada a partir
  // do mês seguinte e a pessoa deixa de ocupar a unidade. É a alternativa a excluir o
  // morador, que cascateia e apaga todo o histórico financeiro dele.
  dataSaida     DateTime?
  diaVencimento Int       @default(10)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  kitnetId Int
  kitnet   Kitnet @relation(fields: [kitnetId], references: [id], onDelete: Cascade)

  pagamentos Pagamento[]

  @@index([kitnetId])
  // Listagens e a geração de parcelas filtram moradores ativos por unidade.
  @@index([kitnetId, dataSaida])
}

model Pagamento {
  id             Int             @id @default(autoincrement())
  valor          Float
  // Mês de competência do aluguel (sempre truncado no dia 1, UTC) — um registro por mês
  // e por tipo (ver @@unique abaixo).
  mesReferencia  DateTime
  vencimento     DateTime
  status         StatusPagamento @default(PENDENTE)
  // Data em que o valor foi efetivamente recebido; preenchida só quando status = PAGO.
  dataPagamento  DateTime?
  // Quanto a imobiliária reteve e quanto sobrou para o proprietário NESTE repasse.
  // Gravados (snapshot) no momento em que a parcela é marcada como paga, e não
  // recalculados depois: mudar a taxa da unidade hoje não pode reescrever o que já foi
  // recebido meses atrás. Nulos enquanto a parcela não for paga, e zerados de volta ao
  // desfazer o pagamento ou anular a parcela.
  valorTaxa      Float?
  valorLiquido   Float?
  formaPagamento String?
  // ALUGUEL (padrão, gerado automaticamente) ou COMPLEMENTAR (lançamento manual extra,
  // que não substitui nem concorre com a parcela do aluguel do mês).
  tipo           TipoPagamento   @default(ALUGUEL)
  // De quem veio o valor, quando não é simplesmente "o morador" (ex.: ex-morador, fiador,
  // terceiro). Usado principalmente em lançamentos COMPLEMENTAR.
  origem         String?
  // Anotação livre explicando um valor fora do padrão (ex.: "Proporcional a 19 dias",
  // "1º mês repassado à imobiliária").
  observacao     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  moradorId Int
  morador   Morador @relation(fields: [moradorId], references: [id], onDelete: Cascade)

  // No máximo um pagamento de cada tipo por morador por mês de competência — garante 1
  // parcela de ALUGUEL por mês, mas permite um lançamento COMPLEMENTAR coexistir com ela.
  // (Sem índice solo em moradorId: o índice único acima já cobre buscas por moradorId
  // sozinho, já que é a coluna líder de um índice composto.)
  @@unique([moradorId, mesReferencia, tipo])
  // Cobre a consulta mais comum do app: pagamentos pendentes/atrasados por vencimento.
  @@index([status, vencimento])
  // A query de receita do dashboard filtra por status PAGO + faixa de `dataPagamento` e
  // nunca toca em `vencimento`, então o índice acima não a atende.
  @@index([status, dataPagamento])
}

model Gasto {
  id        Int      @id @default(autoincrement())
  descricao String
  valor     Float
  data      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kitnetId Int
  kitnet   Kitnet @relation(fields: [kitnetId], references: [id], onDelete: Cascade)

  @@index([kitnetId])
  // O dashboard sempre filtra gastos por faixa de `data` (mês corrente e janela de 6
  // meses); sozinho, o índice de kitnetId não cobre esse recorte.
  @@index([kitnetId, data])
}
